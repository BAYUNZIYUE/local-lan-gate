{
  "name": "local-lan-gate",
  "version": "0.1.0",
  "description": "把 dsh-go 本机引擎的网页版带口令地临时开放到局域网：原生开关、自定义密码、定时自动关闭。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BAYUNZIYUE/local-lan-gate.git"
  },
  "homepage": "https://github.com/BAYUNZIYUE/local-lan-gate#readme",
  "bugs": {
    "url": "https://github.com/BAYUNZIYUE/local-lan-gate/issues"
  },
  "keywords": [
    "dsh",
    "dsh-go",
    "dsh-plugin",
    "deepseek-harness",
    "lan",
    "reverse-proxy"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "minApp": "1.2.0",
    "title": {
      "zh": "局域网网页版",
      "en": "LAN Web UI"
    },
    "icon": "globe",
    "wants": [],
    "contributes": {
      "composer.strip": [
        {
          "id": "lan-strip",
          "icon": "globe",
          "panel": "lan"
        }
      ],
      "panels": [
        {
          "id": "lan",
          "title": {
            "zh": "局域网网页版",
            "en": "LAN Web UI"
          },
          "icon": "globe",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  }
}
